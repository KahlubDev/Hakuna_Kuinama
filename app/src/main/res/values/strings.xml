    <!-- ===== Dashboard ===== -->
    <!--
      Three greetings, not one string with a %s. A user can switch the device language at
      runtime, and a greeting whose word order is fixed by English still reads wrong in a
      language that puts the name first. Keyed by bucket instead.
    -->
    <string name="dashboard_greeting_morning">Good morning, karibu chakula.</string>
    <string name="dashboard_greeting_afternoon">Good afternoon, karibu chakula.</string>
