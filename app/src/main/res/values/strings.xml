    <!-- ===== Menu Builder ===== -->
    <string name="builder_title">What\'s in your kitchen?</string>
    <!--
      A second phrasing of the title, not a repeat of it: the header sets the pair as one
      block, so an exact copy of the title would read as a rendering fault. The Swahili
      locale does the same with two different phrasings of the same question.
    -->
    <string name="builder_subtitle">What have you got in there?</string>
    <string name="builder_tap_what_you_have">Tap what you have</string>
    <plurals name="builder_selection_count">
